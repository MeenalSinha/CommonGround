# CommonGround backend configuration. Copy to .env and fill in. NEVER commit .env.
# This file contains placeholders only.

# Qloo API key. Leave blank until your key is issued: the backend still starts and
# reports the integration as "not configured". Backend-only; never expose to the mobile app.
QLOO_API_KEY=

# Qloo API base URL. Hackathon keys are reported to work only against the hackathon host;
# confirm against the instructions that arrive with your key (see docs/QLOO_SETUP.md).
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Per-request timeout (seconds) and bounded retry count for transient failures.
QLOO_TIMEOUT_SECONDS=10
QLOO_MAX_RETRIES=2

# Search term used by the explicit verification action (a minimal, read-only request).
QLOO_VERIFY_QUERY=music

# Server settings
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins (Expo web / dev tools). Native apps do not use CORS.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
