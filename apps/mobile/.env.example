# Public mobile configuration. EXPO_PUBLIC_* values are bundled into the app and visible to anyone:
# NEVER put secrets here. The Qloo API key lives only in backend/.env.
#
# iOS simulator / web:      http://localhost:8000
# Android emulator:         http://10.0.2.2:8000
# Physical device (Expo Go): http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
